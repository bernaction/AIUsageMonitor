          <StackPanel x:Key="ClaudeConnectionPanel" Margin="0,12,0,0">
            <Border Height="1" Margin="0,0,0,12" Background="#24FFFFFF" />

            <StackPanel x:Name="ClaudeConnectControls">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Claude Web connection"
                             FontFamily="{StaticResource AppFont}"
                             FontWeight="SemiBold"
                             FontSize="12"
                             Foreground="#F2F4F8" />
                  <TextBlock Text="Paste the sessionKey from claude.ai browser cookies"
                             Margin="0,2,0,0"
                             TextWrapping="Wrap"
                             FontFamily="{StaticResource AppFont}"
                             FontSize="10"
                             Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="Open Claude"
                        Margin="8,0,0,0"
                        Style="{StaticResource LinkButtonStyle}"
                        AutomationProperties.Name="Open Claude usage in browser"
                        Click="OpenClaudeUsageButton_Click" />
              </Grid>

              <Border x:Name="ClaudeConnectionTutorial"
                      Margin="0,10,0,0"
                      Padding="10,8"
                      Background="#0FFFFFFF"
                      BorderBrush="#24FFFFFF"
                      BorderThickness="1"
                      CornerRadius="8">
                <StackPanel>
                  <TextBlock Text="HOW TO CONNECT"
                             FontFamily="{StaticResource AppFont}"
                             FontWeight="SemiBold"
                             FontSize="9"
                             Foreground="#AFC8FF" />
                  <TextBlock Margin="0,6,0,0"
                             Text="1. Select Open Claude and sign in to claude.ai."
                             TextWrapping="Wrap"
                             FontFamily="{StaticResource AppFont}"
                             FontSize="9.5"
                             Foreground="#DCE2EC" />
                  <TextBlock Margin="0,4,0,0"
                             Text="2. Press F12, then open Application > Cookies > https://claude.ai."
                             TextWrapping="Wrap"
                             FontFamily="{StaticResource AppFont}"
                             FontSize="9.5"
                             Foreground="#DCE2EC" />
                  <TextBlock Margin="0,4,0,0"
                             Text="3. Select sessionKey and copy only its Value. It begins with sk-ant-."
                             TextWrapping="Wrap"
                             FontFamily="{StaticResource AppFont}"
                             FontSize="9.5"
                             Foreground="#DCE2EC" />
                  <TextBlock Margin="0,4,0,0"
                             Text="4. Paste it below, then press Enter or select Save &amp; connect."
                             TextWrapping="Wrap"
                             FontFamily="{StaticResource AppFont}"
                             FontSize="9.5"
                             Foreground="#DCE2EC" />
                  <TextBlock Margin="0,7,0,0"
                             Text="Only the sessionKey value is needed. It is validated and stored securely in Windows Credential Manager."
                             TextWrapping="Wrap"
                             FontFamily="{StaticResource AppFont}"
                             FontSize="9"
                             Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
              </Border>

              <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Height="30"
                        Padding="8,0"
                        Background="#161A24"
                        BorderBrush="#35FFFFFF"
                        BorderThickness="1"
                        CornerRadius="8">
                  <PasswordBox x:Name="ClaudeSessionKeyPasswordBox"
                               Background="Transparent"
                               BorderThickness="0"
                               Foreground="#E8EBF2"
                               CaretBrush="#E8EBF2"
                               VerticalContentAlignment="Center"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="10.5"
                               AutomationProperties.Name="Claude Web sessionKey"
                               PreviewKeyDown="ClaudeSessionKeyPasswordBox_PreviewKeyDown"
                               ToolTip="sessionKey beginning with sk-ant-" />
                </Border>
                <Button x:Name="SaveClaudeSessionKeyButton"
                        Grid.Column="1"
                        Content="Save &amp; connect"
                        Margin="8,0,0,0"
                        Style="{StaticResource LinkButtonStyle}"
                        Click="SaveClaudeSessionKeyButton_Click" />
              </Grid>

              <TextBlock x:Name="ClaudeConnectionStatusText"
                         Text="Checking connection..."
                         Margin="0,8,0,0"
                         TextWrapping="Wrap"
                         FontFamily="{StaticResource AppFont}"
                         FontSize="9.5"
                         Foreground="{StaticResource MutedTextBrush}" />
            </StackPanel>

            <Button x:Name="DisconnectClaudeButton"
                    Content="Disconnect"
                    HorizontalAlignment="Right"
                    Padding="8,4"
                    Foreground="#F0B889"
                    Background="Transparent"
                    BorderBrush="#45F0B889"
                    BorderThickness="1"
                    Cursor="Hand"
                    FontFamily="{StaticResource AppFont}"
                    FontSize="9.5"
                    IsEnabled="False"
                    Visibility="Collapsed"
                    Click="DisconnectClaudeButton_Click" />
          </StackPanel>
        </Grid.Resources>

        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Settings"
                       FontFamily="{StaticResource AppFont}"
                       FontWeight="SemiBold"
                       FontSize="18"
                       Foreground="#F7F8FC" />
            <TextBlock Text="Customize the gadget services"
                       Margin="0,3,0,0"
                       FontFamily="{StaticResource AppFont}"
                       FontSize="11"
                       Foreground="{StaticResource MutedTextBrush}" />
          </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,24,0,12">
          <TextBlock Text="SERVICES"
                     FontFamily="{StaticResource AppFont}"
                     FontWeight="SemiBold"
                     FontSize="10"
                     Foreground="{StaticResource MutedTextBrush}" />
          <TextBlock Text="Select what to display and drag the handle on the left to reorder."
                     Margin="0,5,0,0"
                     TextWrapping="Wrap"
                     FontFamily="{StaticResource AppFont}"
                     FontSize="11"
                     Foreground="#C4CBD9" />
        </StackPanel>

