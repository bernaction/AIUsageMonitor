                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                          <GradientStop Color="#55A7F8" Offset="0" />
                          <GradientStop Color="#7B70F6" Offset="0.5" />
                          <GradientStop Color="#D764DD" Offset="1" />
                        </LinearGradientBrush>
                      </Path.Fill>
                    </Path>
                  </Viewbox>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="Gemini" FontFamily="{StaticResource AppFont}" FontWeight="SemiBold" FontSize="14" Foreground="#F6F7FA" />
                  <TextBlock Text="Not connected yet" Margin="0,2,0,0" FontFamily="{StaticResource AppFont}" FontSize="10.5" Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
              </Grid>
              <Border Margin="0,11,0,0" Padding="9,7" Background="#12FFFFFF" CornerRadius="9">
                <TextBlock Text="Connect Gemini to display real usage limits."
                           TextWrapping="Wrap"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="10"
                           Foreground="{StaticResource MutedTextBrush}" />
              </Border>
            </StackPanel>
          </Border>
          </StackPanel>
          </ScrollViewer>
          <TextBlock x:Name="NoProvidersMessage"
                     Text="No services selected.&#x0a;Open settings to choose what to display."
                     Visibility="Collapsed"
                     TextAlignment="Center"
                     TextWrapping="Wrap"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     FontFamily="{StaticResource AppFont}"
                     FontSize="12"
                     Foreground="{StaticResource MutedTextBrush}" />
        </Grid>

        <Button x:Name="SettingsButton"
                Grid.Row="2"
                Margin="0,12,0,0"
                HorizontalAlignment="Right"
                Style="{StaticResource IconButtonStyle}"
                AutomationProperties.Name="Open settings"
                ToolTip="Settings"
                Click="SettingsButton_Click">
          <Viewbox Width="16" Height="16">
            <Grid Width="24" Height="24">
              <Path Data="M11,10.27 L7,3.34 M11,13.73 L7,20.66 M12,22 L12,20 M12,2 L12,4 M14,12 L22,12 M17,20.66 L16,18.93 M17,3.34 L16,5.07 M2,12 L4,12 M20.66,17 L18.93,16 M20.66,7 L18.93,8 M3.34,17 L5.07,16 M3.34,7 L5.07,8"
                    Stroke="#C7CDDA"
                    StrokeThickness="2"
                    StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round"
                    StrokeLineJoin="Round" />
              <Ellipse Width="4" Height="4" Stroke="#C7CDDA" StrokeThickness="2" />
              <Ellipse Width="16" Height="16" Stroke="#C7CDDA" StrokeThickness="2" />
            </Grid>
          </Viewbox>
        </Button>

      </Grid>

      <Grid x:Name="SettingsView" Visibility="Collapsed" Margin="18,16,18,14">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Settings"
                       FontFamily="{StaticResource AppFont}"
                       FontWeight="SemiBold"
                       FontSize="18"
                       Foreground="#F7F8FC" />
            <TextBlock Text="Customize the gadget services"
                       Margin="0,3,0,0"
                       FontFamily="{StaticResource AppFont}"
                       FontSize="11"
                       Foreground="{StaticResource MutedTextBrush}" />
          </StackPanel>
                  <Button Grid.Column="1"
                  Style="{StaticResource IconButtonStyle}"
                  AutomationProperties.Name="Return to gadget"
                  Content="×"
                  FontSize="18"
                  ToolTip="Return to gadget"
                  Click="CloseSettingsButton_Click" />
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,24,0,12">
          <TextBlock Text="SERVICES"
                     FontFamily="{StaticResource AppFont}"
                     FontWeight="SemiBold"
                     FontSize="10"
                     Foreground="{StaticResource MutedTextBrush}" />
          <TextBlock Text="Select what to display and drag the handle on the left to reorder."
                     Margin="0,5,0,0"
                     TextWrapping="Wrap"
                     FontFamily="{StaticResource AppFont}"
                     FontSize="11"
                     Foreground="#C4CBD9" />
        </StackPanel>

        <Grid Grid.Row="2">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
        <ListBox x:Name="ProviderSettingsList"
                 AllowDrop="True"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 Drop="ProviderSettingsList_Drop"
                 DragOver="ProviderSettingsList_DragOver">
          <ListBox.Resources>
            <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource SlimScrollBarStyle}" />
          </ListBox.Resources>
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="Padding" Value="0" />
              <Setter Property="Margin" Value="0,0,0,9" />
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="BorderThickness" Value="0" />
              <Setter Property="Focusable" Value="False" />
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Padding="12"
                      Background="{StaticResource CardBrush}"
                      BorderBrush="{StaticResource CardBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="12">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="⋮⋮"
                             Tag="{Binding}"
                             Cursor="SizeAll"
                             ToolTip="Drag to reorder"
                             FontFamily="Segoe UI Symbol"
                             FontSize="16"
                             Foreground="#758097"
                             VerticalAlignment="Center"
                             PreviewMouseLeftButtonDown="DragHandle_MouseLeftButtonDown"
                             PreviewMouseMove="DragHandle_MouseMove" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DisplayName}"
                               FontFamily="{StaticResource AppFont}"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Foreground="#F2F4F8" />
                    <TextBlock Text="{Binding Description}"
                               Margin="0,2,0,0"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="10"
                               Foreground="{StaticResource MutedTextBrush}" />
                  </StackPanel>
                  <CheckBox Grid.Column="2"
                            IsChecked="{Binding IsVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{Binding DisplayName, StringFormat=Show {0}}"
                            ToolTip="Show or hide"
                            Click="ProviderVisibilityChanged" />
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

          <Border Grid.Row="1"
                  Margin="0,8,0,0"
                  Padding="12"
                  Background="{StaticResource CardBrush}"
                  BorderBrush="{StaticResource CardBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="12">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Claude Web connection"
                             FontFamily="{StaticResource AppFont}"
                             FontWeight="SemiBold"
                             FontSize="12"
                             Foreground="#F2F4F8" />
                  <TextBlock Text="Paste the sessionKey from claude.ai browser cookies"
                             Margin="0,2,0,0"
                             TextWrapping="Wrap"
                             FontFamily="{StaticResource AppFont}"
                             FontSize="10"
                             Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="Open Claude"
                        Margin="8,0,0,0"
                        Style="{StaticResource LinkButtonStyle}"
                        AutomationProperties.Name="Open Claude usage in browser"
                        Click="OpenClaudeUsageButton_Click" />
              </Grid>

              <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Height="30"
                        Padding="8,0"
                        Background="#161A24"
                        BorderBrush="#35FFFFFF"
                        BorderThickness="1"
                        CornerRadius="8">
                  <PasswordBox x:Name="ClaudeSessionKeyPasswordBox"
                               Background="Transparent"
                               BorderThickness="0"
                               Foreground="#E8EBF2"
                               CaretBrush="#E8EBF2"
                               VerticalContentAlignment="Center"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="10.5"
                               AutomationProperties.Name="Claude Web sessionKey"
                               ToolTip="sessionKey beginning with sk-ant-" />
                </Border>
                <Button x:Name="SaveClaudeSessionKeyButton"
                        Grid.Column="1"
                        Content="Save &amp; connect"
                        Margin="8,0,0,0"
                        Style="{StaticResource LinkButtonStyle}"
                        Click="SaveClaudeSessionKeyButton_Click" />
              </Grid>

              <Grid Margin="0,8,0,0">
                <TextBlock x:Name="ClaudeConnectionStatusText"
                           Text="Checking connection..."
                           Margin="0,0,82,0"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="9.5"
                           Foreground="{StaticResource MutedTextBrush}" />
                <Button x:Name="DisconnectClaudeButton"
                        Content="Disconnect"
                        HorizontalAlignment="Right"
                        Padding="8,4"
                        Foreground="#F0B889"
                        Background="Transparent"
                        BorderBrush="#45F0B889"
                        BorderThickness="1"
                        Cursor="Hand"
                        FontFamily="{StaticResource AppFont}"
                        FontSize="9.5"
                        IsEnabled="False"
                        Click="DisconnectClaudeButton_Click" />
              </Grid>
            </StackPanel>
          </Border>

        </Grid>

        <Grid Grid.Row="3" Margin="0,12,0,0">
          <TextBlock x:Name="SettingsHintText"
                     Text="Changes saved automatically"
                     VerticalAlignment="Center"
                     FontFamily="{StaticResource AppFont}"
                     FontSize="10"
                     Foreground="#737D92" />
          <Button Content="Done"
                  HorizontalAlignment="Right"
                  Padding="14,7"
                  Foreground="#EEF1F8"
                  Background="#247C5CFC"
                  BorderBrush="#557C5CFC"
                  BorderThickness="1"
                  Cursor="Hand"
                  FontFamily="{StaticResource AppFont}"
                  Click="CloseSettingsButton_Click" />
        </Grid>
      </Grid>

      <Grid x:Name="AboutView" Visibility="Collapsed" Margin="18,16,18,14">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="About"
                       FontFamily="{StaticResource AppFont}"
                       FontWeight="SemiBold"
                       FontSize="18"
                       Foreground="#F7F8FC" />
            <TextBlock Text="AI Usage Monitor"
                       Margin="0,3,0,0"
                       FontFamily="{StaticResource AppFont}"
                       FontSize="11"
                       Foreground="{StaticResource MutedTextBrush}" />
          </StackPanel>
          <Button Grid.Column="1"
                  Style="{StaticResource IconButtonStyle}"
                  AutomationProperties.Name="Return to gadget"
                  Content="×"
                  FontSize="18"
                  ToolTip="Return to gadget"
                  Click="CloseAboutButton_Click" />
        </Grid>

        <ScrollViewer Grid.Row="1"
                      Margin="0,20,0,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      PanningMode="VerticalOnly">
          <ScrollViewer.Resources>
            <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource SlimScrollBarStyle}" />
          </ScrollViewer.Resources>
          <StackPanel>
            <StackPanel HorizontalAlignment="Center">
              <Border Width="64" Height="64" CornerRadius="19" HorizontalAlignment="Center">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#7C5CFC" Offset="0" />
                    <GradientStop Color="#28C7FA" Offset="1" />
                  </LinearGradientBrush>
                </Border.Background>
                <Viewbox Width="38" Height="38">
                  <Grid Width="24" Height="24">
                    <Path Data="M4,17 A9,9 0 1 1 20,17"
                          Stroke="White"
                          StrokeThickness="2"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" />
                    <Path Data="M12,14 L16.5,9.5"
                          Stroke="White"
                          StrokeThickness="2"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" />
                    <Ellipse Width="3.5"
                             Height="3.5"
                             Fill="White"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Top"
                             Margin="0,12.25,0,0" />
                  </Grid>
                </Viewbox>
              </Border>
              <TextBlock Text="AI Usage Monitor"
                         Margin="0,11,0,0"
                         HorizontalAlignment="Center"
                         FontFamily="{StaticResource AppFont}"
                         FontWeight="SemiBold"
                         FontSize="16"
                         Foreground="#F7F8FC" />
              <TextBlock x:Name="AboutVersionText"
                         Margin="0,3,0,0"
                         HorizontalAlignment="Center"
                         FontFamily="{StaticResource AppFont}"
                         FontSize="10.5"
                         Foreground="{StaticResource MutedTextBrush}" />
            </StackPanel>

            <Border Style="{StaticResource ProviderCardStyle}" Margin="0,18,0,10">
              <StackPanel>
                <TextBlock Text="ABOUT THE APP"
                           FontFamily="{StaticResource AppFont}"
                           FontWeight="SemiBold"
                           FontSize="9.5"
                           Foreground="{StaticResource MutedTextBrush}" />
                <TextBlock Text="A lightweight open-source Windows gadget for keeping AI service usage limits visible at a glance."
                           Margin="0,7,0,0"
                           TextWrapping="Wrap"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="11"
                           LineHeight="17"
                           Foreground="#D5DAE5" />
                <TextBlock Text="Built with .NET 8 and WPF. Local session credentials are used only to request usage information."
                           Margin="0,8,0,0"
                           TextWrapping="Wrap"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="10"
                           LineHeight="15"
                           Foreground="{StaticResource MutedTextBrush}" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource ProviderCardStyle}">
              <StackPanel>
                <TextBlock Text="UPDATES"
                           FontFamily="{StaticResource AppFont}"
                           FontWeight="SemiBold"
                           FontSize="9.5"
                           Foreground="{StaticResource MutedTextBrush}" />
                <TextBlock x:Name="UpdateStatusText"
                           Text="Checking GitHub Releases..."
                           Margin="0,7,0,10"
                           TextWrapping="Wrap"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="10.5"
                           LineHeight="16"
                           Foreground="{StaticResource MutedTextBrush}" />
                <StackPanel Orientation="Horizontal">
                  <Button x:Name="CheckForUpdatesButton"
                          Content="Check again"
                          Style="{StaticResource LinkButtonStyle}"
                          AutomationProperties.Name="Check GitHub Releases for updates"
                          Click="CheckForUpdatesButton_Click" />
                  <Button x:Name="ViewReleaseButton"
                          Content="View release"
                          Margin="8,0,0,0"
                          Style="{StaticResource LinkButtonStyle}"
                          AutomationProperties.Name="Open the latest AI Usage Monitor release"
                          Visibility="Collapsed"
                          Click="ViewReleaseButton_Click" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource ProviderCardStyle}">
              <StackPanel>
                <TextBlock Text="CREATED BY"
                           FontFamily="{StaticResource AppFont}"
                           FontWeight="SemiBold"
                           FontSize="9.5"
                           Foreground="{StaticResource MutedTextBrush}" />
                <TextBlock Text="bernaction"
                           Margin="0,6,0,0"
                           FontFamily="{StaticResource AppFont}"
                           FontWeight="SemiBold"
                           FontSize="14"
                           Foreground="#F2F4F8" />
                <TextBlock Text="Creator and maintainer of AI Usage Monitor."
                           Margin="0,3,0,10"
                           TextWrapping="Wrap"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="10.5"
                           Foreground="{StaticResource MutedTextBrush}" />
                <Button Content="View GitHub profile"
                        HorizontalAlignment="Left"
                        Style="{StaticResource LinkButtonStyle}"
                        AutomationProperties.Name="Open bernaction GitHub profile"
                        Click="AuthorLinkButton_Click" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource ProviderCardStyle}" Margin="0">
              <StackPanel>
                <TextBlock Text="OPEN SOURCE PROJECT"
                           FontFamily="{StaticResource AppFont}"
                           FontWeight="SemiBold"
                           FontSize="9.5"
                           Foreground="{StaticResource MutedTextBrush}" />
                <TextBlock Text="Source code, documentation, issues, and contributions are available on GitHub. Licensed under the MIT License."
                           Margin="0,7,0,10"
                           TextWrapping="Wrap"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="10.5"
                           LineHeight="16"
                           Foreground="#D5DAE5" />
                <Button Content="Open repository"
                        HorizontalAlignment="Left"
                        Style="{StaticResource LinkButtonStyle}"
                        AutomationProperties.Name="Open AI Usage Monitor repository"
                        Click="RepositoryLinkButton_Click" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,12,0,0">
          <TextBlock x:Name="AboutHintText"
                     Margin="0,0,70,0"
                     VerticalAlignment="Center"
                     FontFamily="{StaticResource AppFont}"
                     FontSize="10"
                     Foreground="#F0B889" />
          <Button Content="Done"
                  HorizontalAlignment="Right"
                  Padding="14,7"
                  Foreground="#EEF1F8"
                  Background="#247C5CFC"
                  BorderBrush="#557C5CFC"
                  BorderThickness="1"
                  Cursor="Hand"
                  FontFamily="{StaticResource AppFont}"
                  Click="CloseAboutButton_Click" />
        </Grid>
      </Grid>
