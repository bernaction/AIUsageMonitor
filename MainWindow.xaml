                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="Claude" FontFamily="{StaticResource AppFont}" FontWeight="SemiBold" FontSize="14" Foreground="#F6F7FA" />
                  <TextBlock x:Name="ClaudePlanText" Text="Connect Claude Web in Settings." Margin="0,2,0,0" TextWrapping="Wrap" FontFamily="{StaticResource AppFont}" FontSize="10.5" Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
                <Border Grid.Column="2" Padding="7,3" Background="#142B8B65" CornerRadius="7" VerticalAlignment="Center">
                  <TextBlock x:Name="ClaudeStatusText" Text="Unavailable" FontFamily="{StaticResource AppFont}" FontSize="9.5" Foreground="#F0B889" />
                </Border>
              </Grid>
              <StackPanel Margin="0,12,0,0">
                <StackPanel>
                  <Grid>
                    <TextBlock Text="SESSION · 5H" FontFamily="{StaticResource AppFont}" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock x:Name="ClaudeSessionUsageText" Text="-- used" HorizontalAlignment="Right" FontFamily="{StaticResource AppFont}" FontSize="9.5" FontWeight="SemiBold" Foreground="#F0B889" />
                  </Grid>
                  <ProgressBar x:Name="ClaudeSessionProgress" Style="{StaticResource UsageBarStyle}" Value="0" Maximum="100" Foreground="#E99678" Margin="0,5,0,0" />
                  <TextBlock x:Name="ClaudeSessionResetText" Text="Waiting for an update" Margin="0,5,0,0" FontFamily="{StaticResource AppFont}" FontSize="9.5" Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
                <StackPanel Margin="0,12,0,0">
                  <Grid>
                    <TextBlock Text="WEEKLY" FontFamily="{StaticResource AppFont}" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock x:Name="ClaudeWeeklyUsageText" Text="-- used" HorizontalAlignment="Right" FontFamily="{StaticResource AppFont}" FontSize="9.5" FontWeight="SemiBold" Foreground="#F0B889" />
                  </Grid>
                  <ProgressBar x:Name="ClaudeWeeklyProgress" Style="{StaticResource UsageBarStyle}" Value="0" Maximum="100" Foreground="#E99678" Margin="0,5,0,0" />
                  <TextBlock x:Name="ClaudeWeeklyResetText" Text="Waiting for an update" Margin="0,5,0,0" FontFamily="{StaticResource AppFont}" FontSize="9.5" Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
              </StackPanel>
              <Border x:Name="ClaudeConnectionHint" Margin="0,11,0,0" Padding="9,7" Background="#12FFFFFF" CornerRadius="9">
                <TextBlock x:Name="ClaudeConnectionHintText"
                           Text="Connect Claude Web in Settings to display real usage limits."
                           TextWrapping="Wrap"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="10"
                           Foreground="{StaticResource MutedTextBrush}" />
              </Border>
            </StackPanel>
          </Border>

          <Border x:Name="GeminiCard" Style="{StaticResource ProviderCardStyle}" Margin="0">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="44" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="36" Height="36" CornerRadius="11" Background="#1D728BFA" BorderBrush="#40728BFA" BorderThickness="1" VerticalAlignment="Top">
                  <Viewbox Width="22" Height="22">
                    <Path Stretch="Uniform" Data="M11.04,19.32 Q12,21.51 12,24 Q12,21.51 12.93,19.32 Q13.89,17.13 15.51,15.51 T19.32,12.96 Q21.51,12 24,12 Q21.51,12 19.32,11.07 A12.3,12.3 0 0 1 15.51,8.49 A12.3,12.3 0 0 1 12.93,4.68 Q12,2.49 12,0 Q12,2.49 11.04,4.68 Q10.11,6.87 8.49,8.49 A12.3,12.3 0 0 1 4.68,11.07 Q2.49,12 0,12 Q2.49,12 4.68,12.96 Q6.87,13.89 8.49,15.51 T11.04,19.32">
