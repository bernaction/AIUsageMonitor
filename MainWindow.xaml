<Window x:Class="AIUsageMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Usage Monitor"
        Width="220"
        Height="560"
        MinWidth="220"
        MinHeight="160"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True">
  <Window.Resources>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#96A0B5" />
    <SolidColorBrush x:Key="CardBrush" Color="#B51B1F2A" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#25FFFFFF" />

    <Style x:Key="IconButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Margin" Value="4,0,0,0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Foreground" Value="#C7CDDA" />
      <Setter Property="Background" Value="#10FFFFFF" />
      <Setter Property="BorderBrush" Value="#20FFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontFamily" Value="Segoe UI Symbol" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="9">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonBorder" Property="Background" Value="#22FFFFFF" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonBorder" Property="Background" Value="#34FFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="LinkButtonStyle" TargetType="Button">
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="Foreground" Value="#DDE4FF" />
      <Setter Property="Background" Value="#247C5CFC" />
      <Setter Property="BorderBrush" Value="#557C5CFC" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="LinkButtonBorder"
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="LinkButtonBorder" Property="Background" Value="#397C5CFC" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="LinkButtonBorder" Property="Background" Value="#557C5CFC" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ModernComboBoxItemStyle" TargetType="{x:Type ComboBoxItem}">
      <Setter Property="Foreground" Value="#E8EBF2" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="9,0" />
      <Setter Property="Height" Value="26" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ComboBoxItem}">
            <Border x:Name="ItemBorder"
                    Margin="2"
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    CornerRadius="6">
              <ContentPresenter VerticalAlignment="Center"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                TextElement.Foreground="{TemplateBinding Foreground}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="#22FFFFFF" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="#347C5CFC" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ModernComboBoxStyle" TargetType="{x:Type ComboBox}">
      <Setter Property="Foreground" Value="#E8EBF2" />
      <Setter Property="Background" Value="#1F2838" />
      <Setter Property="BorderBrush" Value="#3BFFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="9,0" />
      <Setter Property="ItemContainerStyle" Value="{StaticResource ModernComboBoxItemStyle}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ComboBox}">
            <Grid>
              <Border x:Name="ComboBorder"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="7" />
              <ContentPresenter Margin="{TemplateBinding Padding}"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                TextElement.Foreground="{TemplateBinding Foreground}" />
              <Path Data="M0,0 L4,4 L8,0"
                    Margin="0,0,10,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Stroke="#AEB8CB"
                    StrokeThickness="1.5"
                    StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round" />
              <ToggleButton x:Name="DropDownToggle"
                            Background="Transparent"
                            BorderThickness="0"
                            IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                            ClickMode="Press"
                            Focusable="False">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border Background="Transparent" />
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <Popup x:Name="PART_Popup"
                     AllowsTransparency="True"
                     Focusable="False"
                     IsOpen="{TemplateBinding IsDropDownOpen}"
                     Placement="Bottom"
                     PopupAnimation="Fade"
                     StaysOpen="False">
                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                        MaxHeight="180"
                        Margin="0,4,0,0"
                        Padding="4"
                        Background="#F21B1F2A"
                        BorderBrush="#45FFFFFF"
                        BorderThickness="1"
                        CornerRadius="9">
                  <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                    <ItemsPresenter />
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#687C5CFC" />
              </Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#887C5CFC" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ModernCheckBoxStyle" TargetType="{x:Type CheckBox}">
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Foreground" Value="#E5E9F2" />
      <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type CheckBox}">
            <Grid Background="Transparent">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border x:Name="SwitchTrack"
                      Width="32"
                      Height="18"
                      VerticalAlignment="Center"
                      Background="#252C3B"
                      BorderBrush="#48FFFFFF"
                      BorderThickness="1"
                      CornerRadius="9">
                <Ellipse x:Name="SwitchThumb"
                         Width="12"
                         Height="12"
                         Margin="2,0,0,0"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center"
                         Fill="#AEB8CB">
                  <Ellipse.RenderTransform>
                    <TranslateTransform X="0" />
                  </Ellipse.RenderTransform>
                </Ellipse>
              </Border>
              <ContentPresenter Grid.Column="1"
                                Margin="9,0,0,0"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="SwitchTrack" Property="Background" Value="#30394B" />
                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="#687C5CFC" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="SwitchTrack" Property="Background" Value="#7C5CFC" />
                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="#A994FF" />
                <Setter TargetName="SwitchThumb" Property="Fill" Value="#FFFFFF" />
                <Setter TargetName="SwitchThumb" Property="RenderTransform">
                  <Setter.Value>
                    <TranslateTransform X="14" />
                  </Setter.Value>
                </Setter>
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsChecked" Value="True" />
                  <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="SwitchTrack" Property="Background" Value="#8A70FF" />
              </MultiTrigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="#D4CBFF" />
                <Setter TargetName="SwitchTrack" Property="BorderThickness" Value="1.5" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ModernChevronToggleStyle" TargetType="{x:Type ToggleButton}">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Margin" Value="8,0,0,0" />
      <Setter Property="Foreground" Value="#AEB8CB" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ToggleButton}">
            <Border x:Name="ChevronSurface"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8">
              <Path x:Name="ChevronPath"
                    Width="6"
                    Height="10"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Data="M1,1 L5,5 L1,9"
                    RenderTransformOrigin="0.5,0.5"
                    Stretch="Fill"
                    Stroke="{TemplateBinding Foreground}"
                    StrokeEndLineCap="Round"
                    StrokeLineJoin="Round"
                    StrokeStartLineCap="Round"
                    StrokeThickness="1.6">
                <Path.RenderTransform>
                  <RotateTransform Angle="0" />
                </Path.RenderTransform>
              </Path>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ChevronSurface" Property="Background" Value="#18FFFFFF" />
                <Setter TargetName="ChevronSurface" Property="BorderBrush" Value="#28FFFFFF" />
                <Setter Property="Foreground" Value="#E1E5EE" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="ChevronSurface" Property="Background" Value="#247C5CFC" />
                <Setter TargetName="ChevronSurface" Property="BorderBrush" Value="#557C5CFC" />
                <Setter TargetName="ChevronPath" Property="RenderTransform">
                  <Setter.Value>
                    <RotateTransform Angle="90" />
                  </Setter.Value>
                </Setter>
                <Setter Property="Foreground" Value="#D9D2FF" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ChevronSurface" Property="BorderBrush" Value="#A994FF" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="UsageBarStyle" TargetType="ProgressBar">
      <Setter Property="Height" Value="7" />
      <Setter Property="Background" Value="#22FFFFFF" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid x:Name="PART_Track" ClipToBounds="True">
              <Border Background="{TemplateBinding Background}" CornerRadius="4" />
              <Border x:Name="PART_Indicator"
                      HorizontalAlignment="Left"
                      Background="{TemplateBinding Foreground}"
                      CornerRadius="4" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SlimScrollBarStyle" TargetType="{x:Type ScrollBar}">
      <Setter Property="Width" Value="8" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ScrollBar}">
            <Grid Width="8" Background="Transparent">
              <Track x:Name="PART_Track"
                     Orientation="Vertical"
                     IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                Background="Transparent"
                                BorderThickness="0"
                                Opacity="0" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb MinHeight="28">
                    <Thumb.Template>
                      <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbBorder"
                                Width="6"
                                HorizontalAlignment="Center"
                                Background="#5CFFFFFF"
                                CornerRadius="3" />
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="#8CFFFFFF" />
                          </Trigger>
                          <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="#B8FFFFFF" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                Background="Transparent"
                                BorderThickness="0"
                                Opacity="0" />
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ProviderCardStyle" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="14" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <Style x:Key="ProviderSectionStyle" TargetType="Border">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="4,10" />
      <Setter Property="Margin" Value="0" />
    </Style>

    <Style x:Key="ProviderSeparatorStyle" TargetType="Border">
      <Setter Property="Height" Value="1" />
      <Setter Property="Margin" Value="4,4" />
      <Setter Property="Background" Value="#2EFFFFFF" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
  </Window.Resources>

  <Window.ContextMenu>
    <ContextMenu Opened="GadgetContextMenu_Opened">
      <MenuItem Header="Settings..." Click="ContextSettingsMenuItem_Click" />
      <MenuItem Header="Font size">
        <MenuItem x:Name="SmallFontMenuItem" Header="Small" Tag="0.85" IsCheckable="True" Click="FontSizeMenuItem_Click" />
        <MenuItem x:Name="DefaultFontMenuItem" Header="Default" Tag="1.0" IsCheckable="True" Click="FontSizeMenuItem_Click" />
        <MenuItem x:Name="LargeFontMenuItem" Header="Large" Tag="1.15" IsCheckable="True" Click="FontSizeMenuItem_Click" />
      </MenuItem>
      <MenuItem x:Name="AlwaysOnTopMenuItem"
                Header="Always on top"
                IsCheckable="True"
                Click="AlwaysOnTopMenuItem_Click" />
      <Separator />
      <MenuItem Header="Exit" Click="ExitMenuItem_Click" />
    </ContextMenu>
  </Window.ContextMenu>

  <Border Margin="0"
          CornerRadius="20"
          BorderThickness="0"
          MouseLeftButtonDown="WindowSurface_MouseLeftButtonDown">
    <Border CornerRadius="20"
            Background="#F5161822">

      <Grid>
      <Grid x:Name="DashboardView" Margin="14">
        <Grid.LayoutTransform>
          <ScaleTransform x:Name="DashboardScaleTransform" ScaleX="1" ScaleY="1" />
        </Grid.LayoutTransform>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
          <StackPanel x:Name="DashboardContentPanel">
            <Border Padding="4,4,4,10">
              <Grid x:Name="TokenSummaryGrid"
                    ToolTip="Today's local token usage across the services selected in Settings. Cost is estimated from model pricing.">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock x:Name="TokensTodayLabelText"
                             Text="TOKENS TODAY"
                             FontFamily="{StaticResource AppFont}"
                             FontSize="9"
                             FontWeight="SemiBold"
                             Foreground="{StaticResource MutedTextBrush}" />
                  <TextBlock x:Name="TotalTokensText"
                             Text="—"
                             Margin="0,2,0,0"
                             TextWrapping="NoWrap"
                             FontFamily="{StaticResource AppFont}"
                             FontSize="25"
                             FontWeight="SemiBold"
                             Typography.NumeralAlignment="Tabular"
                             Foreground="#F6F7FA" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Bottom">
                  <TextBlock x:Name="EstimatedCostLabelText"
                             Text="EST. COST"
                             HorizontalAlignment="Right"
                             FontFamily="{StaticResource AppFont}"
                             FontSize="9"
                             FontWeight="SemiBold"
                             Foreground="{StaticResource MutedTextBrush}" />
                  <TextBlock x:Name="EstimatedCostText"
                             Text="$—"
                             Margin="0,4,0,1"
                             TextWrapping="NoWrap"
                             HorizontalAlignment="Right"
                             FontFamily="{StaticResource AppFont}"
                             FontSize="12"
                             FontWeight="SemiBold"
                             Foreground="#C4CBD9" />
                </StackPanel>
              </Grid>
            </Border>
            <Border Style="{StaticResource ProviderSeparatorStyle}" Margin="4,0,4,4" />

            <StackPanel x:Name="ProviderCardsPanel">
          <Border x:Name="CodexCard" Style="{StaticResource ProviderSectionStyle}">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="22" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="18" Height="18" CornerRadius="5.5" Background="#F1F2F4" VerticalAlignment="Center">
                  <Viewbox Width="11" Height="11">
                    <Path Fill="#18191D"
                          Stretch="Uniform"
                          Data="M11.248,18.25 Q10.423,18.25 9.68,17.936 A4.3,4.3 0 0 1 8.36,17.062 A4,4 0 0 1 7.056,17.276 A4,4 0 0 1 5.01,16.732 A4.27,4.27 0 0 1 3.492,15.247 A4,4 0 0 1 2.932,13.152 Q2.932,12.672 3.063,12.112 A4.4,4.4 0 0 1 2.04,10.71 A4.07,4.07 0 0 1 2.057,7.31 A4.2,4.2 0 0 1 3.113,5.892 A3.8,3.8 0 0 1 4.713,5.05 A3.9,3.9 0 0 1 5.473,3.367 Q6.066,2.608 6.924,2.179 A4.04,4.04 0 0 1 8.756,1.75 Q9.581,1.75 10.323,2.063 Q11.065,2.377 11.643,2.938 A4,4 0 0 1 12.947,2.723 Q14.053,2.723 14.993,3.268 A4.14,4.14 0 0 1 16.494,4.753 Q17.072,5.694 17.072,6.848 Q17.072,7.328 16.94,7.888 Q17.6,8.498 17.963,9.307 Q18.326,10.099 18.326,10.973 Q18.326,11.865 17.946,12.69 A4.3,4.3 0 0 1 16.874,14.125 A3.8,3.8 0 0 1 15.29,14.95 A3.8,3.8 0 0 1 14.515,16.633 A4.06,4.06 0 0 1 13.079,17.821 A4.04,4.04 0 0 1 11.248,18.25 M7.172,16.188 Q7.997,16.188 8.607,15.841 L11.71,14.059 A.36,.36 0 0 0 11.874,13.746 V12.326 L7.881,14.62 A.67,.67 0 0 1 7.155,14.62 L4.037,12.822 A.5,.5 0 0 1 4.02,12.937 V13.135 Q4.02,13.976 4.416,14.686 Q4.829,15.379 5.555,15.775 A3.2,3.2 0 0 0 7.172,16.187 M7.337,13.498 A.4,.4 0 0 0 7.518,13.548 Q7.601,13.548 7.683,13.498 L8.921,12.788 L4.944,10.478 A.7,.7 0 0 1 4.581,9.835 V6.255 Q3.756,6.617 3.261,7.377 A2.9,2.9 0 0 0 2.766,9.027 Q2.766,9.836 3.179,10.577 Q3.591,11.32 4.251,11.7 Z M11.247,17.161 Q12.122,17.161 12.832,16.765 A2.96,2.96 0 0 0 14.366,14.125 V10.561 A.32,.32 0 0 0 14.201,10.264 L12.947,9.538 V14.142 A.7,.7 0 0 1 12.584,14.785 L9.465,16.584 A3,3 0 0 0 11.248,17.161 M11.874,13.122 V8.878 L10.01,7.822 L8.129,8.878 V11.122 L10.01,12.178 Z M7.057,5.859 A.7,.7 0 0 1 7.42,5.215 L10.539,3.417 A3,3 0 0 0 8.757,2.839 Q7.883,2.839 7.173,3.235 A2.96,2.96 0 0 0 6.05,4.324 A3.07,3.07 0 0 0 5.654,5.875 V9.422 Q5.654,9.621 5.819,9.736 L7.056,10.462 Z M15.44,13.746 Q16.265,13.382 16.743,12.623 Q17.238,11.865 17.238,10.973 A3.15,3.15 0 0 0 16.826,9.423 Q16.413,8.68 15.753,8.3 L12.667,6.518 Q12.568,6.453 12.486,6.469 A.3,.3 0 0 0 12.321,6.519 L11.083,7.211 L15.076,9.538 A.6,.6 0 0 1 15.34,9.802 A.64,.64 0 0 1 15.44,10.165 Z M12.123,5.364 A.63,.63 0 0 1 12.849,5.364 L15.984,7.195 V6.898 Q15.984,6.106 15.588,5.397 A2.86,2.86 0 0 0 14.483,4.242 Q13.773,3.812 12.833,3.812 Q12.008,3.812 11.397,4.159 L8.294,5.941 A.36,.36 0 0 0 8.129,6.255 V7.673 Z" />
                  </Viewbox>
                </Border>
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           FontFamily="{StaticResource AppFont}"><Run Text="Codex" FontSize="14" FontWeight="SemiBold" Foreground="#F6F7FA" /><Run Text="  " /><Run x:Name="CodexPlanText" Text="Loading local data..." FontSize="10.5" Foreground="{StaticResource MutedTextBrush}" /></TextBlock>
                <Border Grid.Column="2" Padding="7,3" Background="#1639D98A" CornerRadius="8" VerticalAlignment="Center">
                  <TextBlock x:Name="CodexStatusText" Text="Reading" FontFamily="{StaticResource AppFont}" FontSize="9.5" Foreground="#67E6A7" />
                </Border>
              </Grid>

              <StackPanel Margin="0,12,0,0">
                <StackPanel>
                  <Grid>
                    <TextBlock Text="SESSION · 5H" FontFamily="{StaticResource AppFont}" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock x:Name="CodexSessionUsageText" Text="-- used" HorizontalAlignment="Right" FontFamily="{StaticResource AppFont}" FontSize="9.5" FontWeight="SemiBold" Foreground="#DDE2EC" />
                  </Grid>
