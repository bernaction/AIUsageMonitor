          </ListBox.Resources>
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="Padding" Value="0" />
              <Setter Property="Margin" Value="0,0,0,9" />
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="BorderThickness" Value="0" />
              <Setter Property="Focusable" Value="False" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border Background="Transparent">
                      <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border x:Name="ProviderOptionBorder"
                      Padding="14"
                      Background="{StaticResource CardBrush}"
                      BorderBrush="{StaticResource CardBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="16">
                <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="23" />
                    <ColumnDefinition Width="39" />
                    <ColumnDefinition Width="29" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="⋮⋮"
                             Tag="{Binding}"
                             Cursor="SizeAll"
                             ToolTip="Drag to reorder"
                             FontFamily="Segoe UI Symbol"
                             FontSize="16"
                             Foreground="#758097"
                             VerticalAlignment="Center"
                             PreviewMouseLeftButtonDown="DragHandle_MouseLeftButtonDown"
                             PreviewMouseMove="DragHandle_MouseMove" />
                  <CheckBox Grid.Column="1"
                            Style="{StaticResource ModernCheckBoxStyle}"
                            IsChecked="{Binding IsVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{Binding DisplayName, StringFormat=Show {0}}"
                            ToolTip="Show or hide"
                            Click="ProviderVisibilityChanged" />
                  <ContentControl Grid.Column="2"
                                  Content="{Binding}"
                                  ContentTemplate="{StaticResource ProviderSettingsIconTemplate}"
                                  VerticalAlignment="Center" />
                  <StackPanel Grid.Column="3" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DisplayName}"
                               FontFamily="{StaticResource AppFont}"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Foreground="#F2F4F8" />
                    <TextBlock Text="{Binding Description}"
                               Margin="0,2,0,0"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="10"
                               Foreground="{StaticResource MutedTextBrush}" />
                  </StackPanel>
                  <ToggleButton x:Name="ClaudeChevronButton"
                                Grid.Column="4"
                                Style="{StaticResource ModernChevronToggleStyle}"
                                Visibility="Collapsed"
                                VerticalAlignment="Center"
                                ToolTip="Open Claude connection settings" />
                  <ToggleButton x:Name="KiroChevronButton"
                                Grid.Column="4"
                                Style="{StaticResource ModernChevronToggleStyle}"
                                Visibility="Collapsed"
                                VerticalAlignment="Center"
                                ToolTip="Choose the Kiro source" />
                </Grid>
                <ContentControl x:Name="ClaudeConnectionHost" Visibility="Collapsed" />
                <Border x:Name="KiroSourcePanel"
                        Margin="91,10,0,0"
                        Padding="10"
                        Background="#14000000"
                        BorderBrush="#26FFFFFF"
                        BorderThickness="1"
                        CornerRadius="8"
                        Visibility="Collapsed">
                  <StackPanel>
                    <TextBlock Text="USAGE SOURCE"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="9"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource MutedTextBrush}" />
                    <ComboBox Margin="0,7,0,0"
                              SelectedValue="{Binding SourcePreference, Mode=OneWay}"
                              SelectedValuePath="Tag"
                              Foreground="#1A1D26"
                              AutomationProperties.Name="Kiro usage source"
                              SelectionChanged="KiroSourceSelectionChanged">
                      <ComboBoxItem Content="Automatic" Tag="automatic" />
                      <ComboBoxItem Content="Kiro CLI" Tag="cli" />
                      <ComboBoxItem Content="Kiro IDE" Tag="ide" />
                    </ComboBox>
                    <TextBlock Text="Automatic uses the first signed-in source that returns usable data."
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="9.5"
                               Foreground="{StaticResource MutedTextBrush}" />
                  </StackPanel>
                </Border>
                </StackPanel>
              </Border>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding ProviderId}" Value="claude">
                  <Setter TargetName="ClaudeChevronButton" Property="Visibility" Value="Visible" />
                  <Setter TargetName="ClaudeConnectionHost"
                          Property="Content"
                          Value="{StaticResource ClaudeConnectionPanel}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ProviderId}" Value="kiro">
                  <Setter TargetName="KiroChevronButton" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                  <Setter TargetName="ProviderOptionBorder" Property="Background" Value="#227C5CFC" />
                  <Setter TargetName="ProviderOptionBorder" Property="BorderBrush" Value="#8A7C5CFC" />
                </DataTrigger>
                <Trigger SourceName="ClaudeChevronButton" Property="IsChecked" Value="True">
                  <Setter TargetName="ClaudeChevronButton" Property="ToolTip" Value="Close Claude connection settings" />
                  <Setter TargetName="ClaudeConnectionHost" Property="Visibility" Value="Visible" />
                </Trigger>
                <Trigger SourceName="KiroChevronButton" Property="IsChecked" Value="True">
                  <Setter TargetName="KiroChevronButton" Property="ToolTip" Value="Close Kiro source settings" />
                  <Setter TargetName="KiroSourcePanel" Property="Visibility" Value="Visible" />
                </Trigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        </Grid>

        <Grid Grid.Row="3" Margin="0,12,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <StackPanel>
            <CheckBox x:Name="StartWithWindowsCheckBox"
                      Style="{StaticResource ModernCheckBoxStyle}"
                      Content="Start with Windows"
                      VerticalAlignment="Center"
                      AutomationProperties.Name="Start AI Usage Monitor with Windows"
                      Checked="StartWithWindowsCheckBox_Changed"
                      Unchecked="StartWithWindowsCheckBox_Changed" />
            <TextBlock Text="Open the gadget after you sign in. Keep its extracted folder in a permanent location."
                       Margin="41,3,0,0"
                       TextWrapping="Wrap"
                       FontFamily="{StaticResource AppFont}"
                       FontSize="9.5"
                       Foreground="{StaticResource MutedTextBrush}" />
          </StackPanel>

          <Grid Grid.Row="1" Margin="0,12,0,0">
            <TextBlock x:Name="SettingsHintText"
                       Text="Changes saved automatically"
                       VerticalAlignment="Center"
                       FontFamily="{StaticResource AppFont}"
                       FontSize="10"
                       Foreground="#737D92" />
            <Button Content="Done"
                    HorizontalAlignment="Right"
                    Padding="14,7"
                    Foreground="#EEF1F8"
                    Background="#247C5CFC"
                    BorderBrush="#557C5CFC"
                    BorderThickness="1"
                    Cursor="Hand"
                    FontFamily="{StaticResource AppFont}"
                    Click="CloseSettingsButton_Click" />
          </Grid>
        </Grid>
      </Grid>

      <Grid x:Name="AboutView" Visibility="Collapsed" Margin="18,16,18,14">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="About"
                       FontFamily="{StaticResource AppFont}"
                       FontWeight="SemiBold"
                       FontSize="18"
                       Foreground="#F7F8FC" />
            <TextBlock Text="AI Usage Monitor"
                       Margin="0,3,0,0"
                       FontFamily="{StaticResource AppFont}"
                       FontSize="11"
                       Foreground="{StaticResource MutedTextBrush}" />
          </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1"
                      Margin="0,20,0,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      PanningMode="VerticalOnly">
          <ScrollViewer.Resources>
            <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource SlimScrollBarStyle}" />
          </ScrollViewer.Resources>
          <StackPanel>
            <StackPanel HorizontalAlignment="Center">
              <Image Width="64"
                     Height="64"
                     HorizontalAlignment="Center"
                     Source="Assets/AIUsageMonitor.png"
                     Stretch="Uniform"
                     RenderOptions.BitmapScalingMode="HighQuality"
                     AutomationProperties.Name="AI Usage Monitor logo" />
              <TextBlock Text="AI Usage Monitor"
                         Margin="0,11,0,0"
                         HorizontalAlignment="Center"
                         FontFamily="{StaticResource AppFont}"
                         FontWeight="SemiBold"
                         FontSize="16"
                         Foreground="#F7F8FC" />
              <TextBlock x:Name="AboutVersionText"
                         Margin="0,3,0,0"
                         HorizontalAlignment="Center"
                         FontFamily="{StaticResource AppFont}"
                         FontSize="10.5"
                         Foreground="{StaticResource MutedTextBrush}" />
            </StackPanel>

            <Border Style="{StaticResource ProviderCardStyle}" Margin="0,18,0,10">
              <StackPanel>
                <TextBlock Text="ABOUT THE APP"
                           FontFamily="{StaticResource AppFont}"
                           FontWeight="SemiBold"
                           FontSize="9.5"
                           Foreground="{StaticResource MutedTextBrush}" />
                <TextBlock Text="A lightweight open-source Windows gadget for keeping AI service usage limits visible at a glance."
                           Margin="0,7,0,0"
                           TextWrapping="Wrap"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="11"
                           LineHeight="17"
                           Foreground="#D5DAE5" />
                <TextBlock Text="Built with .NET 8 and WPF. Local session credentials are used only to request usage information."
                           Margin="0,8,0,0"
                           TextWrapping="Wrap"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="10"
                           LineHeight="15"
                           Foreground="{StaticResource MutedTextBrush}" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource ProviderCardStyle}">
              <StackPanel>
                <TextBlock Text="UPDATES"
                           FontFamily="{StaticResource AppFont}"
                           FontWeight="SemiBold"
                           FontSize="9.5"
                           Foreground="{StaticResource MutedTextBrush}" />
                <TextBlock x:Name="UpdateStatusText"
                           Text="Checking GitHub Releases..."
                           Margin="0,7,0,10"
                           TextWrapping="Wrap"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="10.5"
                           LineHeight="16"
                           Foreground="{StaticResource MutedTextBrush}" />
                <StackPanel Orientation="Horizontal">
                  <Button x:Name="CheckForUpdatesButton"
                          Content="Check again"
                          Style="{StaticResource LinkButtonStyle}"
                          AutomationProperties.Name="Check GitHub Releases for updates"
                          Click="CheckForUpdatesButton_Click" />
                  <Button x:Name="DownloadUpdateButton"
                          Content="Download update"
                          Margin="8,0,0,0"
                          Style="{StaticResource LinkButtonStyle}"
                          AutomationProperties.Name="Choose where to save the AI Usage Monitor update"
                          Visibility="Collapsed"
                          Click="DownloadUpdateButton_Click" />
                  <Button x:Name="ViewReleaseButton"
                          Content="View release"
                          Margin="8,0,0,0"
                          Style="{StaticResource LinkButtonStyle}"
                          AutomationProperties.Name="Open the latest AI Usage Monitor release"
                          Visibility="Collapsed"
                          Click="ViewReleaseButton_Click" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource ProviderCardStyle}">
              <StackPanel>
                <TextBlock Text="CREATED BY"
                           FontFamily="{StaticResource AppFont}"
                           FontWeight="SemiBold"
                           FontSize="9.5"
                           Foreground="{StaticResource MutedTextBrush}" />
                <TextBlock Text="bernaction"
                           Margin="0,6,0,0"
                           FontFamily="{StaticResource AppFont}"
                           FontWeight="SemiBold"
                           FontSize="14"
                           Foreground="#F2F4F8" />
                <TextBlock Text="Creator and maintainer of AI Usage Monitor."
                           Margin="0,3,0,10"
                           TextWrapping="Wrap"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="10.5"
                           Foreground="{StaticResource MutedTextBrush}" />
                <Button Content="View GitHub profile"
                        HorizontalAlignment="Left"
                        Style="{StaticResource LinkButtonStyle}"
                        AutomationProperties.Name="Open bernaction GitHub profile"
                        Click="AuthorLinkButton_Click" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource ProviderCardStyle}" Margin="0">
              <StackPanel>
                <TextBlock Text="OPEN SOURCE PROJECT"
                           FontFamily="{StaticResource AppFont}"
                           FontWeight="SemiBold"
                           FontSize="9.5"
                           Foreground="{StaticResource MutedTextBrush}" />
                <TextBlock Text="Source code, documentation, issues, and contributions are available on GitHub. Licensed under the MIT License."
                           Margin="0,7,0,10"
                           TextWrapping="Wrap"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="10.5"
                           LineHeight="16"
                           Foreground="#D5DAE5" />
                <Button Content="Open repository"
                        HorizontalAlignment="Left"
                        Style="{StaticResource LinkButtonStyle}"
                        AutomationProperties.Name="Open AI Usage Monitor repository"
                        Click="RepositoryLinkButton_Click" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,12,0,0">
          <TextBlock x:Name="AboutHintText"
                     Margin="0,0,70,0"
                     VerticalAlignment="Center"
                     FontFamily="{StaticResource AppFont}"
                     FontSize="10"
                     Foreground="#F0B889" />
          <Button Content="Done"
                  HorizontalAlignment="Right"
                  Padding="14,7"
                  Foreground="#EEF1F8"
                  Background="#247C5CFC"
                  BorderBrush="#557C5CFC"
                  BorderThickness="1"
                  Cursor="Hand"
                  FontFamily="{StaticResource AppFont}"
                  Click="CloseAboutButton_Click" />
        </Grid>
      </Grid>
      </Grid>
    </Border>
  </Border>
</Window>
