<Window x:Class="AIUsageMonitor.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Usage Monitor Settings"
        Width="420"
        Height="650"
        MinWidth="360"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#121420"
        UseLayoutRounding="True">
  <Border x:Name="ContentHost"
          BorderBrush="#36FFFFFF"
          BorderThickness="1">
    <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF1B1D29" Offset="0" />
        <GradientStop Color="#FF121420" Offset="0.58" />
        <GradientStop Color="#FF1A1627" Offset="1" />
      </LinearGradientBrush>
    </Border.Background>
  </Border>
</Window>
